{
  "//": "案件リポの .claude/settings.json に置く（安定チャンネル）。リポをトラストしたメンバーに cortex プラグインのインストールが自動案内される。cortex はエンジンリポを直接参照し、ref: stable で安定版に固定する（ref を省略すると main 追従＝カナリア）",
  "permissions": {
    "deny": [
      "Read(credentials/)"
    ]
  },
  "extraKnownMarketplaces": {
    "cortex-engine": {
      "source": {
        "source": "github",
        "repo": "classmethod-team-app/cortex-engine",
        "ref": "stable"
      }
    }
  },
  "enabledPlugins": {
    "cortex@cortex-engine": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-sync.sh\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
